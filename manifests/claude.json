      "owner": "firefly",
      "kind": "superpowers-plugin-override",
      "upstream": "superpowers-claude-plugin"
    },
    {
      "id": "runtime-bootstrap-script",
      "source": "scripts/bootstrap-project.sh",
      "target": "~/.claude/firefly/bin/bootstrap-project.sh",
      "owner": "firefly",
      "kind": "runtime-script"
    },
    {
      "id": "runtime-list-change-tasks-script",
      "source": "scripts/list-change-tasks.sh",
      "target": "~/.claude/firefly/bin/list-change-tasks.sh",
      "owner": "firefly",
      "kind": "runtime-script"
    },
    {
      "id": "runtime-firefly-draw-script",
      "source": "scripts/firefly-draw.sh",
      "target": "~/.claude/firefly/bin/firefly-draw.sh",
      "owner": "firefly",
      "kind": "runtime-script"
    },
    {
      "id": "runtime-doctor-script",
      "source": "scripts/doctor-claude.sh",
      "target": "~/.claude/firefly/bin/doctor-claude.sh",
      "owner": "firefly",
      "kind": "runtime-script"
    },
    {
      "id": "runtime-common-script",
      "source": "scripts/firefly-common.sh",
      "target": "~/.claude/firefly/bin/firefly-common.sh",
      "owner": "firefly",
      "kind": "runtime-script",
      "note": "Shared shell helpers sourced by runtime install/doctor scripts; provides portable SHA-256."
    },
    {
      "id": "runtime-chinese-openspec-validator",
      "source": "scripts/validate-openspec-cn.mjs",
      "target": "~/.claude/firefly/bin/validate-openspec-cn.mjs",
      "owner": "firefly",
      "kind": "runtime-script"
    },
    {
      "id": "runtime-firefly-command",
      "source": "scripts/firefly.sh",
      "target": "~/.claude/firefly/bin/firefly",
      "owner": "firefly",
      "kind": "runtime-command"
    },
    {
      "id": "global-firefly-command",
      "source": "scripts/firefly-global.sh",
      "target": "~/.local/bin/firefly",
      "owner": "firefly",
      "kind": "global-command",
      "note": "A platform-neutral command that dispatches to installed firefly runtimes."
    },
    {
      "id": "firefly-home-mirror",
      "source": "repo root (assets, scripts, manifests)",
      "target": "~/.claude/firefly",
      "owner": "firefly",
      "kind": "source-mirror",
      "note": "Source baseline mirrored by install so global doctor/repair can diff installed assets against firefly-owned copies from any directory."
    }
  ]
