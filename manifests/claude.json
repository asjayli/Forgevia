{
  "version": 1,
  "fireflyVersion": "0.1.0",
  "platform": "claude",
  "managedRoot": "~/.claude",
  "sources": {
    "openspec": {
      "type": "npm",
      "package": "@fission-ai/openspec",
      "version": "1.6.0",
      "install": "npm install -g @fission-ai/openspec@1.6.0",
      "overrideTargetVersion": "1.6.0"
    },
    "superpowers": {
      "type": "claude-plugin-marketplace",
      "marketplace": "obra/superpowers-marketplace",
      "plugin": "superpowers@superpowers-marketplace",
      "install": [
        "/plugin marketplace add obra/superpowers-marketplace",
        "/plugin install superpowers@superpowers-marketplace"
      ],
      "notes": "firefly relies on the upstream Claude superpowers plugin, then overlays managed customizations."
    }
  },
  "managedAssets": [
    {
      "id": "openspec-config-prompts",
      "source": "assets/openspec/dist/core/config-prompts.js",
      "target": "<openspec-root>/dist/core/config-prompts.js",
      "owner": "firefly",
      "kind": "openspec-override",
      "upstream": "openspec"
    },
    {
      "id": "openspec-propose-workflow",
      "source": "assets/openspec/dist/core/templates/workflows/propose.js",
      "target": "<openspec-root>/dist/core/templates/workflows/propose.js",
      "owner": "firefly",
      "kind": "openspec-override",
      "upstream": "openspec"
    },
    {
      "id": "openspec-apply-change-skill",
      "source": "assets/claude/skills/openspec-apply-change",
      "target": "~/.claude/skills/openspec-apply-change",
      "owner": "firefly",
      "kind": "skill-directory"
    },
    {
      "id": "openspec-archive-change-skill",
      "source": "assets/claude/skills/openspec-archive-change",
      "target": "~/.claude/skills/openspec-archive-change",
      "owner": "firefly",
      "kind": "skill-directory"
    },
    {
