#!/usr/bin/env bash
# Generate a review package: commit list, stat summary, and the net
# diff with extended context, written to a file the reviewer reads in one
# call. Using the recorded per-task BASE (not HEAD~1) keeps multi-commit
# tasks intact.
#
# Usage: review-package --snapshot
#        review-package BASE HEAD|WORKTREE [OUTFILE]
# Default OUTFILE: <repo-root>/.superpowers/sdd/review-<base7>..<head7>.diff
# WORKTREE packages compare a task-start tree snapshot with a fresh tree
# snapshot, isolating consecutive uncommitted tasks without touching the real
# index or worktree.
set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)
script_dir=$(cd "$(dirname "$0")" && pwd)
workspace=$("$script_dir/sdd-workspace")

snapshot_tree() (
  exclude=${1:-}
  index=$(mktemp "$workspace/review-index.XXXXXX")
  trap 'rm -f "$index"' EXIT
  rm -f "$index"

  GIT_INDEX_FILE="$index" git -C "$repo_root" read-tree HEAD
  GIT_INDEX_FILE="$index" git -C "$repo_root" add -A
  if [ -n "$exclude" ]; then
    GIT_INDEX_FILE="$index" git -C "$repo_root" rm --cached -q --ignore-unmatch -- "$exclude"
  fi
  GIT_INDEX_FILE="$index" git -C "$repo_root" write-tree
)

if [ $# -eq 1 ] && [ "$1" = "--snapshot" ]; then
  snapshot_tree
  exit 0
fi

if [ $# -lt 2 ] || [ $# -gt 3 ]; then
  echo "usage: review-package --snapshot | BASE HEAD|WORKTREE [OUTFILE]" >&2
  exit 2
fi

base=$1
head=$2

git -C "$repo_root" cat-file -e "${base}^{tree}" 2>/dev/null || { echo "bad BASE tree: $base" >&2; exit 2; }
if [ "$head" != "WORKTREE" ]; then
  git -C "$repo_root" cat-file -e "${base}^{commit}" 2>/dev/null || { echo "BASE is not a commit: $base" >&2; exit 2; }
  git -C "$repo_root" cat-file -e "${head}^{commit}" 2>/dev/null || { echo "bad HEAD commit: $head" >&2; exit 2; }
fi

if [ $# -eq 3 ]; then
  case $3 in
    /*) out=$3 ;;
    *) out="$(pwd)/$3" ;;
  esac
else
  if [ "$head" = "WORKTREE" ]; then
    out=$(mktemp "$workspace/review-$(git -C "$repo_root" rev-parse --short "$base")..worktree.XXXXXX")
  else
    out="$workspace/review-$(git -C "$repo_root" rev-parse --short "$base")..$(git -C "$repo_root" rev-parse --short "$head").diff"
  fi
fi

out_dir=$(dirname "$out")
[ -d "$out_dir" ] || { echo "missing OUTFILE directory: $out_dir" >&2; exit 2; }
[ ! -L "$out" ] || { echo "OUTFILE must not be a symlink: $out" >&2; exit 2; }
out=$(cd "$out_dir" && pwd -P)/$(basename "$out")

exclude=
case $out in
  "$repo_root"/*)
    exclude=${out#"$repo_root"/}
    if git -C "$repo_root" ls-files --error-unmatch -- "$exclude" >/dev/null 2>&1; then
      echo "OUTFILE must not overwrite a tracked file: $exclude" >&2
      exit 2
    fi
    ;;
esac

if [ "$head" = "WORKTREE" ]; then
  current_tree=$(snapshot_tree "$exclude")
  diff_pathspec=()
  if [ -n "$exclude" ]; then
    diff_pathspec=(-- . ":(top,exclude,literal)$exclude")
  fi
  {
    echo "# Review package: ${base}..WORKTREE"
    echo
    echo "## Commits"
    if git -C "$repo_root" cat-file -e "${base}^{commit}" 2>/dev/null; then
      git -C "$repo_root" log --oneline "${base}..HEAD"
    else
      echo "Task baseline is worktree tree ${base}"
    fi
    echo
    echo "## Files changed"
    git -C "$repo_root" diff --stat "$base" "$current_tree" "${diff_pathspec[@]}"
    echo
    echo "## Diff"
    git -C "$repo_root" diff -U10 "$base" "$current_tree" "${diff_pathspec[@]}"
  } > "$out"
else
  {
    echo "# Review package: ${base}..${head}"
    echo
    echo "## Commits"
    git -C "$repo_root" log --oneline "${base}..${head}"
    echo
    echo "## Files changed"
    git -C "$repo_root" diff --stat "${base}..${head}"
    echo
    echo "## Diff"
    git -C "$repo_root" diff -U10 "${base}..${head}"
  } > "$out"
fi

if [ "$head" = "WORKTREE" ]; then
  echo "wrote ${out}: worktree snapshot diff, $(wc -c < "$out" | tr -d ' ') bytes"
else
  commits=$(git -C "$repo_root" rev-list --count "${base}..${head}")
  echo "wrote ${out}: ${commits} commit(s), $(wc -c < "$out" | tr -d ' ') bytes"
fi
